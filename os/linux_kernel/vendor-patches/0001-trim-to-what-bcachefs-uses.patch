 helpers/helpers.c          | 44 +++++++++----------
 kernel/cpu.rs              |  3 +-
 kernel/lib.rs              | 86 +++++++++++++++++++-------------------
 kernel/mm.rs               |  7 ++++
 kernel/prelude.rs          | 18 +-------
 kernel/uaccess.rs          |  2 +-
 7 files changed, 91 insertions(+), 149 deletions(-)

