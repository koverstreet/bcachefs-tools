From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kent Overstreet <kent.overstreet@linux.dev>
Date: Mon, 16 Nov 2026 16:42:27 -0500
Subject: [PATCH] drop sync::poll

PollCondVar's drop calls __wake_up_pollfree, which the kernel doesn't
export, so a module can't link it. bcachefs doesn't use it.

---

diff --git a/kernel/sync.rs b/kernel/sync.rs
index ee372c048a8a..175bdf1131b5 100644
--- a/kernel/sync.rs
+++ b/kernel/sync.rs
@@ -14,7 +14,10 @@ mod condvar;
 pub mod lock;
 pub mod lockdep;
 mod locked_by;
-pub mod poll;
+// vendored-trim: PollCondVar (sync::poll) is unused by bcachefs and its drop
+// calls __wake_up_pollfree, which the kernel never EXPORT_SYMBOLs (6.18 or 7.x);
+// bundled into a module that symbol can't link. bcachefs doesn't use poll, so
+// drop the module rather than carry an unresolvable reference.
 pub mod rcu;
 mod refcount;
 mod set_once;
