# SPDX-License-Identifier: GPL-2.0
#
# The vendored Rust stack: a patched copy of the kernel's rust/ (7.1), in
# fs/vendor/kernel-rust, built into $(obj)/vrust and bundled into bcachefs.ko,
# for when the kernel's own Rust can't be used (fs/Makefile.rust decides).
# Its Rust symbols stay module-local; only the kernel's C ABI crosses the .ko
# boundary. The kernel tree is only read.

VRD	:= $(obj)/vrust
VRD_ABS	:= $(abspath $(VRD))
VENDOR	:= $(src)/vendor/kernel-rust
# core's source: RUST_LIB_SRC if given, else rustc's rust-src - as the
# kernel's rust/Makefile, since some packagings (nixpkgs) keep it outside the
# sysroot and pass it this way.
bch-rustc-sysroot := $(shell $(RUSTC) --print sysroot)
RUST_LIB_SRC ?= $(bch-rustc-sysroot)/lib/rustlib/src/rust/library

# ---- adapting the kernel's build to our rustc ------------------------------
# The kernel's KBUILD_RUSTFLAGS (set even with CONFIG_RUST=n), rustc_cfg and
# target.json were made for the rustc it was configured with - not ours, or we
# wouldn't be here. Redo for $(RUSTC) what the kernel decided by its version.
# KBUILD_RUSTFLAGS is rewritten in place: every rule expands it lazily.

bch-rust-L := -L$(VRD)

# target.json, where the kernel's flags use one (x86; the other architectures
# use rustc's builtin targets, and the generator refuses them): a Rust-off
# kernel has none, and a Rust kernel's is for its rustc (the format changes
# between versions). Ours, from the kernel's generator told our version, made
# at parse time so every rule sees it - and removed if that fails, not left
# empty by the redirect. The generator is vendored too: distros' kernel headers
# don't all ship it (Debian's don't, #1133).
ifneq ($(filter --target=$(objtree)/scripts/target.json,$(KBUILD_RUSTFLAGS)),)
bch-target-json := $(VRD_ABS)/target.json
bch-target-gen := $(VENDOR)/scripts/generate_rust_target.rs
$(shell	mkdir -p '$(VRD_ABS)' &&						\
	{ [ '$(VRD_ABS)/generate_rust_target' -nt '$(bch-target-gen)' ] || \
	  $(HOSTRUSTC) --edition=2021 -Copt-level=0			\
	    '$(bch-target-gen)' -o '$(VRD_ABS)/generate_rust_target'; } && \
	{ grep -v '^CONFIG_RUSTC_VERSION=' '$(objtree)/include/config/auto.conf'; \
	  echo CONFIG_RUSTC_VERSION=$(bch-rustc-version); } |	\
	'$(VRD_ABS)/generate_rust_target' > '$(bch-target-json).tmp' &&	\
	{ cmp -s '$(bch-target-json).tmp' '$(bch-target-json)' && rm -f '$(bch-target-json).tmp' || \
	  mv '$(bch-target-json).tmp' '$(bch-target-json)'; } ||		\
	rm -f '$(bch-target-json)' '$(bch-target-json).tmp')
ifneq ($(wildcard $(bch-target-json)),)
KBUILD_RUSTFLAGS := $(patsubst --target=$(objtree)/scripts/target.json,--target=$(bch-target-json),$(KBUILD_RUSTFLAGS))
else ifneq ($(.DEFAULT_GOAL),__clean)
$(error bcachefs: failed to generate $(bch-target-json) with $(bch-target-gen))
endif
endif

# rustc_cfg: the kernel's, with its CONFIG_RUSTC_HAS_* replaced by ours, at
# init/Kconfig's thresholds. Its own mkdir: target.json's above is x86 only.
bch-vr-rustc-has := SPAN_FILE:108800 UNNECESSARY_TRANSMUTES:108800 FILE_WITH_NUL:108900 \
	FILE_AS_C_STR:109100 SUSPICIOUS_RUNTIME_SYMBOL_DEFINITIONS:109800
bch-rustc-cfg := $(VRD_ABS)/rustc_cfg
$(shell mkdir -p '$(VRD_ABS)' && \
	{ grep -v '^--cfg=CONFIG_RUSTC_' '$(objtree)/include/generated/rustc_cfg'; \
	$(foreach h,$(bch-vr-rustc-has),$(if $(call bch-rustc-min,$(lastword $(subst :, ,$(h)))),\
		echo --cfg=CONFIG_RUSTC_HAS_$(firstword $(subst :, ,$(h)));)) } > '$(bch-rustc-cfg)')

# -Zno-jump-tables became -Cjump-tables=n in 1.93: pass whichever we take.
ifneq ($(filter -Cjump-tables=n -Zno-jump-tables,$(KBUILD_RUSTFLAGS)),)
KBUILD_RUSTFLAGS := $(filter-out -Cjump-tables=n -Zno-jump-tables,$(KBUILD_RUSTFLAGS)) \
	$(shell $(RUSTC) -Cjump-tables=n --print=sysroot >/dev/null 2>&1 && \
		echo -Cjump-tables=n || echo -Zno-jump-tables)
endif

# rustc < 1.98 doesn't record frame pointers or unwind tables in the LLVM
# module flags (rust-lang/rust#156980, #156973); the kernel adds them by hand
# when it asks for either (top Makefile, arch/arm64), if its rustc needs it.
bch-vr-fp-flag := -Zllvm_module_flag=frame-pointer:u32:2:max
bch-vr-uwt-flag := -Zllvm_module_flag=uwtable:u32:2:max
KBUILD_RUSTFLAGS := $(filter-out $(bch-vr-fp-flag) $(bch-vr-uwt-flag),$(KBUILD_RUSTFLAGS)) \
	$(if $(call bch-rustc-min,109800),,\
		$(if $(filter -Cforce-frame-pointers=y,$(KBUILD_RUSTFLAGS)),$(bch-vr-fp-flag)) \
		$(if $(filter arm64,$(SRCARCH)),$(if $(filter -Cforce-unwind-tables=y,$(KBUILD_RUSTFLAGS)),$(bch-vr-uwt-flag))))

# A kernel only has Rust with module BTF if pahole can skip Rust units and
# there's no LTO (init/Kconfig); outside that our DWARF breaks the module's BTF
# (#1086), so build without debuginfo.
ifdef CONFIG_DEBUG_INFO_BTF_MODULES
ifneq ($(CONFIG_PAHOLE_HAS_LANG_EXCLUDE)$(CONFIG_LTO),y)
KBUILD_RUSTFLAGS := $(filter-out $(DEBUG_RUSTFLAGS),$(KBUILD_RUSTFLAGS)) -Cdebuginfo=0
endif
endif

# KASAN only where the kernel allows it with Rust (init/Kconfig: RUST depends
# on !KASAN || CC_IS_CLANG, and SW_TAGS on rustc 1.96): rustc's
# instrumentation doesn't match gcc's.
ifneq ($(CONFIG_CC_IS_CLANG),y)
RUSTFLAGS_KASAN :=
else ifdef CONFIG_KASAN_SW_TAGS
RUSTFLAGS_KASAN := $(if $(call bch-rustc-min,109600),$(RUSTFLAGS_KASAN))
endif

# AutoFDO's debuginfo flag, spelled for our rustc (renamed in 1.98).
ifdef CONFIG_AUTOFDO_CLANG
RUSTFLAGS_AUTOFDO_CLANG := $(filter-out -Zdebuginfo-for-profiling -Zdebug-info-for-profiling,$(RUSTFLAGS_AUTOFDO_CLANG)) \
	$(if $(call bch-rustc-min,109800),-Zdebuginfo-for-profiling,-Zdebug-info-for-profiling)
endif

# ---- the vendored crates ---------------------------------------------------
# Built by Makefile.rust's rules; all vendored, so all lint-capped. The
# kernel's own rules for them are in vendor/kernel-rust/Makefile.

# bindgen, as the kernel's rule does it: the carried bindgen_parameters, and
# the kernel's C flags less the ones libclang can't parse. No --target, as for
# our codegen: the host's. -I rust/bindings: the helper headers' relative
# includes ("../../drivers/base/base.h") resolve from there.
bch-vr-bindgen-cflags := $(LINUXINCLUDE) -I$(srctree)/rust/bindings $(KBUILD_CPPFLAGS) \
	$(filter-out $(bcachefs-codegen-skip-cflags),$(KBUILD_CFLAGS)) \
	-fno-builtin -D__BINDGEN__ -DMODULE -DKBUILD_MODNAME='"bcachefs"' -w
quiet_cmd_bch_vr_bindgen = BINDGEN $@
      cmd_bch_vr_bindgen = $(BINDGEN) $< $(rs-bindgen-flags) --rust-target 1.85 \
	--use-core --with-derive-default --ctypes-prefix ffi --no-layout-tests \
	--no-debug '.*' --enable-function-attribute-detection -o $@ \
	-- $(bch-vr-bindgen-cflags) $(rs-bindgen-cflags) $(rs-post)

# The proc-macros, on Makefile.rust's host crates:
$(VRD)/libmacros.so $(VRD)/libzerocopy_derive.so: private rs-flags := $(bch-pmac)
$(VRD)/libpin_init_internal.so: private rs-flags := $(bch-pmac) --cfg kernel --cfg USE_RUSTC_FEATURES

$(VRD)/libmacros.so: $(VENDOR)/macros/lib.rs $(bch-pmac-deps)
	$(call if_changed_dep,bch_procmacro)
$(VRD)/libzerocopy_derive.so: $(VENDOR)/zerocopy-derive/lib.rs $(bch-pmac-deps)
	$(call if_changed_dep,bch_procmacro)
$(VRD)/libpin_init_internal.so: $(VENDOR)/pin-init/internal/src/lib.rs $(bch-pmac-deps)
	$(call if_changed_dep,bch_procmacro)

# core, our rustc's own, at its own edition; the soft-float and u128
# intrinsics routed to __rust*, which compiler_builtins stubs.
vr-redirect-intrinsics := __addsf3 __eqsf2 __extendsfdf2 __gesf2 __lesf2 __ltsf2 \
	__mulsf3 __nesf2 __truncdfsf2 __unordsf2 __adddf3 __eqdf2 __ledf2 __ltdf2 \
	__muldf3 __unorddf2 __muloti4 __multi3 __udivmodti4 __udivti3 __umodti3
$(VRD)/core.o: private rs-edition := $(shell sed -n 's/^edition *= *"\(.*\)"/\1/p' $(RUST_LIB_SRC)/core/Cargo.toml)
$(VRD)/core.o: private rs-flags := --cap-lints=allow --cfg no_fp_fmt_parse
$(VRD)/core.o: private rs-post = ; $(OBJCOPY) $(foreach s,$(vr-redirect-intrinsics),--redefine-sym $(s)=__rust$(s)) $@
$(VRD)/core.o: $(RUST_LIB_SRC)/core/src/lib.rs FORCE
	$(call if_changed_dep,bch_rlib)
KCOV_INSTRUMENT_vrust/core.o := n

vr-core := --cap-lints=allow --extern core=$(VRD)/libcore.rmeta
$(VRD)/compiler_builtins.o: private rs-flags := $(vr-core)
$(VRD)/compiler_builtins.o: private rs-post = ; $(OBJCOPY) -w -W '__*' $@
$(VRD)/compiler_builtins.o: $(VENDOR)/compiler_builtins.rs $(VRD)/core.o FORCE
	$(call if_changed_dep,bch_rlib)

# Everything else is built on those two - our leaf crates too:
vr-base := $(vr-core) --extern compiler_builtins=$(VRD)/libcompiler_builtins.rmeta
vr-base-deps := $(VRD)/compiler_builtins.o FORCE
$(obj)/bitfield.o $(obj)/bitflags.o $(obj)/uuid.o: $(VRD)/compiler_builtins.o

$(VRD)/ffi.o $(VRD)/build_error.o: private rs-flags := $(vr-base)
$(VRD)/ffi.o: $(VENDOR)/ffi.rs $(vr-base-deps)
	$(call if_changed_dep,bch_rlib)
$(VRD)/build_error.o: $(VENDOR)/build_error.rs $(vr-base-deps)
	$(call if_changed_dep,bch_rlib)

$(VRD)/zerocopy.o: private rs-env := CARGO_PKG_VERSION=0.8.50
$(VRD)/zerocopy.o: private rs-flags := $(vr-base) --extern zerocopy_derive=$(VRD)/libzerocopy_derive.so
$(VRD)/zerocopy.o: $(VENDOR)/zerocopy/src/lib.rs $(VRD)/libzerocopy_derive.so $(vr-base-deps)
	$(call if_changed_dep,bch_rlib)

$(VRD)/pin_init.o: private rs-flags := $(vr-base) --cfg kernel --cfg USE_RUSTC_FEATURES \
	--extern pin_init_internal=$(VRD)/libpin_init_internal.so --extern macros=$(VRD)/libmacros.so
$(VRD)/pin_init.o: $(VENDOR)/pin-init/src/lib.rs $(VRD)/libpin_init_internal.so \
	$(VRD)/libmacros.so $(vr-base-deps)
	$(call if_changed_dep,bch_rlib)

# bindings and uapi: bindgen on the kernel headers. The crates, and kernel's
# generated arch asm below, are found under $OBJTREE/rust - so OBJTREE is ours.
vr-bindgen-params := $(shell grep -Ev '^\#|^$$' $(VENDOR)/bindgen_parameters)
$(VRD)/rust/bindings/bindings_generated.rs $(VRD)/rust/uapi/uapi_generated.rs: \
	private rs-bindgen-flags := $(vr-bindgen-params)
$(VRD)/rust/bindings/bindings_generated.rs: private rs-post = ; \
	sed -Ei 's/pub const RUST_CONST_HELPER_([a-zA-Z0-9_]*)/pub const \1/g' $@
$(VRD)/rust/bindings/bindings_helpers_generated.rs: private rs-bindgen-flags := \
	--blocklist-type '.*' --allowlist-var '' --allowlist-function 'rust_helper_.*'
$(VRD)/rust/bindings/bindings_helpers_generated.rs: private rs-bindgen-cflags := \
	-I$(VRD)/rust/bindings -Wno-missing-prototypes -Wno-missing-declarations
$(VRD)/rust/bindings/bindings_helpers_generated.rs: private rs-post = ; \
	sed -Ei 's/pub fn rust_helper_([a-zA-Z0-9_]*)/#[link_name="rust_helper_\1"]\n    pub fn \1/g' $@

$(VRD)/rust/bindings/bindings_generated.rs: $(VENDOR)/bindings/bindings_helper.h $(VENDOR)/bindgen_parameters FORCE
	$(Q)mkdir -p $(@D)
	$(call if_changed,bch_vr_bindgen)
$(VRD)/rust/bindings/bindings_helpers_generated.rs: $(VENDOR)/helpers/helpers.c FORCE
	$(Q)mkdir -p $(@D)
	$(call if_changed,bch_vr_bindgen)
$(VRD)/rust/uapi/uapi_generated.rs: $(VENDOR)/uapi/uapi_helper.h $(VENDOR)/bindgen_parameters FORCE
	$(Q)mkdir -p $(@D)
	$(call if_changed,bch_vr_bindgen)

vr-kernel-deps := $(vr-base) --extern ffi=$(VRD)/libffi.rmeta --extern pin_init=$(VRD)/libpin_init.rmeta
$(VRD)/bindings.o $(VRD)/uapi.o $(VRD)/kernel.o: private rs-env := OBJTREE=$(VRD_ABS)
$(VRD)/bindings.o $(VRD)/uapi.o: private rs-flags := $(vr-kernel-deps)
$(VRD)/bindings.o: $(VENDOR)/bindings/lib.rs $(VRD)/ffi.o $(VRD)/pin_init.o \
	$(VRD)/rust/bindings/bindings_generated.rs $(VRD)/rust/bindings/bindings_helpers_generated.rs FORCE
	$(call if_changed_dep,bch_rlib)
$(VRD)/uapi.o: $(VENDOR)/uapi/lib.rs $(VRD)/ffi.o $(VRD)/pin_init.o \
	$(VRD)/rust/uapi/uapi_generated.rs FORCE
	$(call if_changed_dep,bch_rlib)

# The kernel crate, and the arch asm it includes, preprocessed from .rs.S:
quiet_cmd_bch_vr_rscpp = RSCPP   $@
      cmd_bch_vr_rscpp = $(CPP) $(c_flags) -xc -C -P $< | sed '1,/^\/\/ Cut here.$$/d' >$@
vr-arch-gen-rs := $(foreach f,static_branch warn reachable,$(VRD)/rust/kernel/generated_arch_$(f)_asm.rs)
$(vr-arch-gen-rs): $(VRD)/rust/kernel/%.rs: $(VENDOR)/kernel/%.rs.S FORCE
	$(Q)mkdir -p $(@D)
	$(call if_changed,bch_vr_rscpp)

$(VRD)/kernel.o: private rs-flags := $(vr-kernel-deps) \
	--extern build_error=$(VRD)/libbuild_error.rmeta --extern macros=$(VRD)/libmacros.so \
	--extern bindings=$(VRD)/libbindings.rmeta --extern uapi=$(VRD)/libuapi.rmeta \
	--extern zerocopy=$(VRD)/libzerocopy.rmeta --extern zerocopy_derive=$(VRD)/libzerocopy_derive.so
$(VRD)/kernel.o: $(VENDOR)/kernel/lib.rs $(VRD)/build_error.o $(VRD)/bindings.o \
	$(VRD)/uapi.o $(VRD)/zerocopy.o $(vr-arch-gen-rs) FORCE
	$(call if_changed_dep,bch_rlib)

# The rust_helper_* C the kernel crate calls; helpers.c #includes helpers/*.c.
quiet_cmd_bch_vr_helpers = CC [M]  $@
      cmd_bch_vr_helpers = $(CC) $(c_flags) -I$(VENDOR)/include -c -o $@ $<
$(VRD)/helpers.o: $(VENDOR)/helpers/helpers.c $(wildcard $(VENDOR)/helpers/*.c) FORCE
	$(Q)mkdir -p $(@D)
	$(call if_changed_dep,bch_vr_helpers)

# ---- mod.o: bcachefs's Rust, against the vendored crates --------------------
# What kbuild's Rust rule does on the kernel's-Rust path - its per-object flags
# included - but with our externs and cfgs. It supplies no_std and OBJTREE as
# that rule does; mod.rs mustn't (a no_std attribute there is a duplicate on
# the kbuild path: unused_attributes, fatal under CONFIG_WERROR).
quiet_cmd_bch_vr_mod = RUSTC M  $@
      cmd_bch_vr_mod = OUT_DIR=$(abspath $(obj)/rust) OBJTREE=$(VRD_ABS) \
	$(RUSTC) $(filter-out --edition=%,$(_rust_flags)) @$(bch-rustc-cfg) \
	--edition=2021 -Awarnings -Zunstable-options --sysroot=/dev/null \
	-L$(VRD) -Zcrate-attr=no_std -Zcrate-attr='feature($(rust_allowed_features))' \
	--crate-type rlib --crate-name bcachefs_mod \
	--extern core=$(VRD)/libcore.rmeta --extern kernel=$(VRD)/libkernel.rmeta \
	--extern pin_init=$(VRD)/libpin_init.rmeta --extern bindings=$(VRD)/libbindings.rmeta \
	--extern zerocopy=$(VRD)/libzerocopy.rmeta \
	--emit=obj=$@ $<
$(obj)/mod.o: $(src)/mod.rs $(obj)/rust/bindings.rs $(VRD)/kernel.o $(VRD)/zerocopy.o FORCE
	$(call if_changed,bch_vr_mod)

bch-vr-objs := $(addprefix vrust/,core.o compiler_builtins.o ffi.o build_error.o \
	zerocopy.o pin_init.o bindings.o uapi.o kernel.o helpers.o)
bcachefs-y += $(bch-vr-objs)
targets += $(bch-vr-objs) $(addprefix vrust/,libmacros.so libpin_init_internal.so \
	libzerocopy_derive.so) \
	$(patsubst $(obj)/%,%,$(vr-arch-gen-rs) $(addprefix $(VRD)/rust/,\
	bindings/bindings_generated.rs bindings/bindings_helpers_generated.rs uapi/uapi_generated.rs))
