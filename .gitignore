# Vendored-Rust build scratch: fs/Makefile builds the kernel's target-spec
# generator in here and runs it to produce target.json, and
# Makefile.rust.vendor stages the vendored stack alongside it. All generated,
# and the generator is a multi-megabyte binary sitting in the source tree.
fs/vrust/

# will have compiled files and executables
/build/
/debug/
/target/
/vendor/
package-ci/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
